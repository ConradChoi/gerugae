# Supabase 대시보드 → Project Settings → API 에서 복사합니다.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# anon public key — 브라우저에 노출되어도 되는 키입니다 (RLS가 지켜 줍니다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — 서버 전용. RLS를 전부 우회하므로 브라우저로 새면
# 모든 회원의 모든 데이터가 열립니다. 회원 탈퇴 시 계정 삭제에만 씁니다.
# NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
